filters:
  and:
    - file.inFolder("00 - Connectivity/inbox")
formulas:
  Foo Bar: file.name
properties:
  note.baz.foo:
    displayName: Baz Foo
views:
  - type: table
    name: New
    filters:
      and:
        - type.isEmpty()
    order:
      - file.name
      - tags
    sort:
      - property: priority
        direction: DESC
      - property: file.mtime
        direction: DESC
    columnSize:
      note.type: 91
      file.name: 800
      note.stage: 95
      note.priority: 111
      note.rank: 74
  - type: table
    name: Index
    order:
      - type
      - file.name
      - description
      - stage
      - priority
      - rank
      - tags
    sort:
      - property: priority
        direction: DESC
      - property: file.mtime
        direction: DESC
    columnSize:
      note.type: 75
      file.name: 800
      note.description: 366
      note.stage: 95
      note.priority: 111
      note.rank: 74
  - type: table
    name: Test Export View
    order:
      - file.name
      - formula.Foo Bar
      - baz.foo
      - bar.baz
    sort:
      - property: baz.foo
        direction: DESC
    columnSize:
      file.name: 751
      formula.Foo Bar: 119
