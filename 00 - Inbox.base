filters:
  and:
    - file.inFolder("00 - Connectivity/inbox")
formulas:
  Foo Bar: file.name
properties:
  note.baz.foo:
    displayName: Baz Foo
views:
  - type: table
    name: New
    filters:
      and:
        - '!stage.containsAny("delivered", "partially-delivered", "done")'
    order:
      - file.name
      - stage
      - file.ctime
      - tags
    sort:
      - property: file.ctime
        direction: DESC
      - property: priority
        direction: DESC
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 554
      note.stage: 88
  - type: table
    name: Discovery
    filters:
      and:
        - stage == "discovery"
    order:
      - file.name
      - description
      - stage
      - priority
      - rank
      - tags
    sort:
      - property: priority
        direction: DESC
      - property: file.mtime
        direction: DESC
    columnSize:
      note.type: 75
      file.name: 800
      note.description: 366
      note.stage: 95
      note.priority: 111
      note.rank: 74
  - type: table
    name: Partially Delivered
    filters:
      and:
        - stage == "partially-delivered"
    order:
      - file.name
      - description
      - priority
      - rank
      - stage
      - tags
    sort:
      - property: priority
        direction: DESC
      - property: file.mtime
        direction: DESC
    columnSize:
      note.type: 75
      file.name: 536
      note.description: 507
      note.stage: 95
      note.priority: 111
      note.rank: 74
  - type: table
    name: Delivered
    filters:
      and:
        - stage == "delivered"
    order:
      - file.name
      - description
      - priority
      - rank
      - stage
      - tags
    sort:
      - property: priority
        direction: DESC
      - property: file.mtime
        direction: DESC
    columnSize:
      note.type: 75
      file.name: 800
      note.description: 366
      note.stage: 95
      note.priority: 111
      note.rank: 74
  - type: table
    name: Index
    order:
      - type
      - file.name
      - description
      - stage
      - priority
      - rank
      - tags
    sort:
      - property: priority
        direction: DESC
      - property: file.mtime
        direction: DESC
    columnSize:
      note.type: 75
      file.name: 800
      note.description: 366
      note.stage: 95
      note.priority: 111
      note.rank: 74
  - type: table
    name: Test Export View
    order:
      - file.name
      - formula.Foo Bar
      - baz.foo
      - bar.baz
    sort:
      - property: baz.foo
        direction: DESC
    columnSize:
      file.name: 751
      formula.Foo Bar: 119
