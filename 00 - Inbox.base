filters:
  and:
    - file.inFolder("00 - Connectivity/inbox")
views:
  - type: table
    name: New
    filters:
      and:
        - type.isEmpty()
    order:
      - type
      - file.name
      - tags
    sort:
      - property: priority
        direction: DESC
      - property: file.mtime
        direction: DESC
    columnSize:
      note.type: 91
      file.name: 800
      note.stage: 95
      note.priority: 111
      note.rank: 74
  - type: table
    name: Index
    order:
      - type
      - file.name
      - description
      - stage
      - priority
      - rank
      - tags
    sort:
      - property: priority
        direction: DESC
      - property: file.mtime
        direction: DESC
    columnSize:
      note.type: 75
      file.name: 800
      note.stage: 95
      note.priority: 111
      note.rank: 74
