filters:
  and:
    - file.inFolder("Development/flowti/docs/jobs to be done")
views:
  - type: table
    name: Job to be done
    groupBy:
      property: persona
      direction: ASC
    order:
      - file.name
      - type
      - persona
    columnSize:
      file.name: 539
      note.type: 120
      note.persona: 161
  - type: table
    name: View
