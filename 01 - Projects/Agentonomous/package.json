{
  "name": "agentonomous",
  "version": "0.0.1",
  "description": "Run and observe autonomous agents directly in your Obsidian vault.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "vite build",
    "build:deploy": "node scripts/build-and-deploy.mjs",
    "deploy": "node scripts/deploy-to-test-vault.mjs",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:unit:ui": "vitest --project unit --ui --open --coverage",
    "test:watch": "vitest --project unit",
    "test:stories": "vitest run --project storybook",
    "test:coverage": "vitest run --project unit --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ stories/ --no-error-on-unmatched-pattern",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs": "typedoc --options configs/typedoc.json",
    "release": "node scripts/package-release.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.0.7",
    "@storybook/addon-a11y": "^10.3.0",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-onboarding": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.0",
    "@storybook/vue3-vite": "^10.3.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.4",
    "@vue/test-utils": "^2.4.6",
    "archiver": "^7.0.1",
    "eslint": "^10.1.0",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "eslint-plugin-storybook": "^10.3.5",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^29.0.1",
    "obsidian": "^1.12.3",
    "pinia": "^2.3.0",
    "storybook": "^10.3.0",
    "typedoc": "^0.28.18",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^10.0.0",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.4.0",
    "vue-tsc": "^2.2.0"
  }
}
