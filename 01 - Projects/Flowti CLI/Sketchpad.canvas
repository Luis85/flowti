{
	"nodes":[
		{"id":"63c9876d3229d100","type":"group","x":1120,"y":-1600,"width":2760,"height":2320,"label":"Flowti CLI"},
		{"id":"9163de1675ce0e76","type":"group","x":1140,"y":-810,"width":2700,"height":800,"label":"Domain"},
		{"id":"3fd8e3916db726e3","type":"group","x":1140,"y":-1520,"width":1760,"height":540,"label":"Intro"},
		{"id":"850530599bf5841d","type":"group","x":2260,"y":110,"width":1580,"height":540,"label":"Lifecycle"},
