{
	"name": "flowti-cli",
	"tools": {
		"build": "npm run build",
		"devtools": "npm run dev"
	},
	"make": {
		"templates": ["journey", "component"]
	},
	"reports": {
		"dir": "reports",
		"generators": [
			{ "id": "test", "label": "Test Report", "prerequisites": ["npm run test:coverage"] },
			{ "id": "coverage", "label": "Coverage Report", "prerequisites": ["npm run test:coverage"] },
			{ "id": "codebase", "label": "Codebase Report", "prerequisites": ["npm run typedoc"] },
			{ "id": "complexity", "label": "Complexity Report", "prerequisites": ["npm run analysis"] },
			{ "id": "status", "label": "Status Report" },
			{ "id": "summary", "label": "Summary Report" }
		],
		"thresholds": {
			"coverageLines": 80,
			"coverageBranches": 70,
			"maxComplexity": 15,
			"complexityAboveThresholdPct": 5,
			"startupMs": 5000,
			"eslintWarnings": 0,
			"lintCommand": "npm run lint",
			"typedocCommand": "npm run typedoc",
			"typedocWarnings": 0
		}
	},
	"docs": {
		"generators": [
			{ "label": "Codebase (TypeDoc)", "command": "npm run typedoc" }
		]
	},
	"publish": {
		"build": "npm run build",
		"test": "npm test",
		"outDir": "../..",
		"artifacts": [
			"flowti.cmd",
			".flowti/config.json",
			".flowti/bin/index.js",
			".flowti/bin/main.js",
			".flowti/bin/main.js.map",
			".flowti/bin/package.json"
		],
		"endpoints": [
			{ "name": "Distribute", "path": "C:/Projects/distribute", "clean": true }
		]
	},
	"review": {
		"journeysDir": "tests/e2e",
		"build": "npm run build",
		"test": "npm test"
	}
}
