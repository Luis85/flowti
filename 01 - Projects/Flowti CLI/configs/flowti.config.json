{
	"name": "flowti-cli",
	"type": "cli",
	"build": {
		"commands": {
			"fast": "npm run build",
			"full": "npm run build",
			"watch": "npm run build:watch",
			"distribute": "npm run build"
		}
	},
	"test": {
		"commands": {
			"unit": "npm test",
			"increment": "npm test"
		}
	},
	"devtools": {
		"commands": {
			"check": "npm run check",
			"lint": "npm run lint"
		},
		"thresholds": {
			"maxComplexity": 10,
			"maxLines": 350
		}
	},
	"make": {
		"templates": [
			"journey",
			"component"
		]
	},
	"components": {
		"storybook": true,
		"storybookDir": "components",
		"framework": "html",
		"markdownSource": {
			"path": "../design-system/components",
			"strategy": "category",
			"requiredFields": ["name", "category", "description", "props", "slots", "variants", "status"]
		}
	},
	"agents": {
		"dashboard": true,
		"dashboardDir": "agents"
	},
	"reports": {
		"dir": "reports",
		"outputDir": "../../03 - Resources/Reports",
		"generators": [
			{
				"id": "test",
				"label": "Test Report",
				"prerequisites": [
					"npx vitest run --config configs/vitest.config.ts --reporter=json --outputFile=reports/tests/testreport.json --coverage --coverage.reportsDirectory=reports/coverage --coverage.reporter=json"
				]
			},
			{
				"id": "coverage",
				"label": "Coverage Report",
				"prerequisites": [
					"npx vitest run --config configs/vitest.config.ts --reporter=json --outputFile=reports/tests/testreport.json --coverage --coverage.reportsDirectory=reports/coverage --coverage.reporter=json"
				]
			},
			{
				"id": "codebase",
				"label": "Codebase Report",
				"prerequisites": [
					"npm run typedoc"
				]
			},
			{
				"id": "complexity",
				"label": "Complexity Report"
			},
			{
				"id": "iteration-retrospective",
				"label": "Iteration Retrospective"
			},
			{
				"id": "effort-report",
				"label": "Effort Report"
			},
			{
				"id": "status",
				"label": "Status Report",
				"dependencies": [
					"test",
					"coverage",
					"codebase",
					"complexity"
				]
			},
			{
				"id": "summary",
				"label": "Summary Report",
				"dependencies": [
					"test",
					"coverage",
					"codebase",
					"complexity",
					"status"
				]
			}
		],
		"thresholds": {
			"coverageLines": 80,
			"coverageBranches": 70,
			"maxComplexity": 15,
			"maxFileDecisionPoints": 90,
			"complexityAboveThresholdPct": 5,
			"startupMs": 5000,
			"eslintWarnings": 0,
			"lintCommand": "npm run lint",
			"typedocCommand": "npm run typedoc",
			"typedocWarnings": 0
		}
	},
	"docs": {
		"allCommand": "npm run typedoc",
		"generators": [
			{
				"label": "Codebase (TypeDoc)",
				"command": "npm run typedoc"
			}
		],
		"referenceDir": "../../03 - Resources/Reference",
		"references": [
			{
				"id": "cli-reference",
				"label": "CLI Reference"
			},
			{
				"id": "entity-reference",
				"label": "Entity Reference"
			},
			{
				"id": "conditions-reference",
				"label": "Conditions Reference"
			},
			{
				"id": "config-reference",
				"label": "Config Reference"
			},
			{
				"id": "component-catalog",
				"label": "Product Component Catalog"
			},
			{
				"id": "health-reference",
				"label": "Health Scoring Reference"
			},
			{
				"id": "project-overview",
				"label": "Project Overview"
			},
			{
				"id": "raid-reference",
				"label": "RAID Reference"
			},
			{
				"id": "sitemap-reference",
				"label": "Sitemap Reference"
			},
			{
				"id": "agent-roster-reference",
				"label": "Agent Roster Reference"
			},
			{
				"id": "agent-skill-map",
				"label": "Agent Skill Map"
			},
			{
				"id": "agent-permission-matrix",
				"label": "Agent Permission Matrix"
			},
			{
				"id": "pdca-dashboard",
				"label": "PDCA Dashboard"
			},
			{
				"id": "resource-inventory",
				"label": "Resource Inventory"
			},
			{
				"id": "requirements-traceability",
				"label": "Requirements Traceability"
			},
			{
				"id": "deliverables-schedule",
				"label": "Deliverables Schedule"
			},
			{
				"id": "onboarding-tour-catalog",
				"label": "Onboarding Tour Catalog"
			}
		]
	},
	"health": {
		"thresholds": {
			"coverage": {
				"min": 70,
				"target": 85
			},
			"lint": {
				"maxErrors": 0,
				"maxWarnings": 5
			},
			"tests": {
				"minPassed": 3600
			}
		}
	},
	"publish": {
		"build": "npm run build",
		"test": "npm test",
		"outDir": "../..",
		"artifacts": [
			"flowti.cmd",
			".flowti/config.json",
			".flowti/bin/index.mjs",
			".flowti/bin/main.js",
			".flowti/bin/main.js.map",
			".flowti/bin/package.json"
		],
		"endpoints": [
			{
				"name": "Distribute",
				"path": "C:/Projects/distribute",
				"clean": true
			}
		]
	},
	"management": {
		"resources": {
			"dir": "docs/resources"
		},
		"timelog": {
			"dir": "docs/timelog"
		},
		"deliverables": {
			"dir": "docs/deliverables"
		},
		"features": {
			"dir": "docs/features"
		},
		"raid": {
			"dir": "docs/raid"
		},
		"requirements": {
			"dir": "docs/requirements"
		},
		"capa": {
			"dir": "docs/capa"
		},
		"iterations": {
			"dir": "iterations",
			"durationDays": 14,
			"orchestration": {
				"phases": {
					"new": {
						"agent": "Product Owner",
						"role": "refiner",
						"instruction": "Refine the goal and identify initial scope items"
					},
					"planned": {
						"agent": "Software Architect",
						"role": "planner",
						"instruction": "Break scope into actionable technical tasks with file-level changes"
					}
				}
			}
		},
		"agents": {
			"roster": [
				"Auditor",
				"Bob",
				"Business Analyst",
				"Delivery Manager",
				"Product Designer",
				"Product Manager",
				"Product Owner",
				"Product Team",
				"Project Manager",
				"Quality Manager",
				"Release Manager",
				"Requirements Engineer",
				"Scrum Master",
				"Software Architect",
				"Software Developer",
				"Tech Lead",
				"Tester",
				"UI Designer",
				"UX Designer"
			]
		}
	},
	"templates": {
		"dir": "docs/templates"
	},
	"review": {
		"journeysDir": "tests/e2e",
		"build": "npm run build",
		"test": "npm test"
	}
}