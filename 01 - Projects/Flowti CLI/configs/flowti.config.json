{
	"name": "flowti-cli",
	"tools": {
		"build": "npm run build",
		"reports": "npm run reports",
		"devtools": "npm run dev"
	},
	"make": {
		"templates": ["journey"]
	},
	"reports": {
		"dir": "reports",
		"allCommand": "npm run reports",
		"generators": [
			{ "label": "Test Report", "command": "npx tsx src/domain/reports/cli/generate-test-report.ts" },
			{ "label": "Coverage Report", "command": "npx tsx src/domain/reports/cli/generate-coverage-report.ts" },
			{ "label": "Codebase Report", "command": "npx tsx src/domain/reports/cli/generate-codebase-report.ts" },
			{ "label": "Complexity Report", "command": "npx tsx src/domain/reports/cli/generate-complexity-report.ts" }
		]
	},
	"docs": {
		"generators": [
			{ "label": "Codebase (TypeDoc)", "command": "npm run docs" },
			{ "label": "CLI Reference", "command": "npx tsx src/domain/reports/generators/cli-reference.ts" }
		]
	}
}
