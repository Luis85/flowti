			"kind": "page",
			"label": "Start Menu",
			"icon": "home",
			"domain": "navigation",
			"status": "active",
			"description": "Entry point — open or create a project, access global tools.",
			"route": {
				"path": "/",
				"pathMatch": "full"
			},
			"onBeforeRender": "start:banner",
			"actions": [
				{
					"name": "onOpenProject",
					"label": "Open Project",
					"type": "handler",
					"target": "project:open",
					"key": "1",
					"group": "project"
				},
				{
					"name": "onCreateProject",
					"label": "Create Project",
					"type": "handler",
					"target": "project:create",
					"key": "2",
					"group": "project"
				},
				{
					"name": "onNavigateProjectDetail",
					"label": "Selected Project: {{project.name}}",
					"type": "navigate",
					"target": "project-detail",
					"key": "g",
					"hidden": "no-project-selected",
					"group": "project"
				},
				{
					"name": "onNavigateAiTools",
					"label": "Agents and AI Tools",
					"type": "navigate",
					"target": "ai-tools",
					"key": "a",
					"group": "tools"
				},
				{
					"name": "onNavigatePlugins",
					"label": "Plugins",
					"type": "navigate",
					"target": "plugins",
					"key": "p",
					"group": "tools"
				},
				{
					"name": "onQuit",
					"label": "Quit",
					"type": "signal",
					"target": "quit",
					"key": "q",
					"group": "nav"
				}
			]
		},
