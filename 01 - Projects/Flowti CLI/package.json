{
	"name": "flowti-cli",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "tsx src/main.ts",
		"build": "tsc --project configs/tsconfig.json",
		"test": "npm run check && vitest run --config configs/vitest.config.ts",
		"test:watch": "vitest --config configs/vitest.config.ts",
		"test:ui": "vitest --config configs/vitest.config.ts --ui",
		"test:coverage": "vitest run --config configs/vitest.config.ts --coverage --reporter=json --outputFile=docs/reports/tests/testreport.json",
		"check": "tsc --project configs/tsconfig.json --noEmit",
		"lint": "eslint --config configs/eslint.config.mjs src/",
		"docs": "typedoc --options configs/typedoc.json",
		"analysis": "complexity-analysis",
		"report:test": "npm run test:coverage && tsx src/domain/reports/cli/generate-test-report.ts",
		"report:coverage": "npm run test:coverage && tsx src/domain/reports/cli/generate-coverage-report.ts",
		"report:codebase": "npm run docs && tsx src/domain/reports/cli/generate-codebase-report.ts",
		"report:complexity": "npm run analysis && tsx src/domain/reports/cli/generate-complexity-report.ts",
		"report:status": "tsx src/domain/reports/cli/generate-status-report.ts",
		"reports": "npm run analysis && tsx src/domain/reports/cli/generate-test-report.ts && tsx src/domain/reports/cli/generate-coverage-report.ts && npm run report:codebase && tsx src/domain/reports/cli/generate-complexity-report.ts"
	},
	"devDependencies": {
		"@pythonidaer/complexity-report": "^1.0.18",
		"@types/node": "^25.3.5",
		"@typescript-eslint/eslint-plugin": "^8.56.1",
		"@typescript-eslint/parser": "^8.56.1",
		"@vitest/coverage-v8": "^4.0.18",
		"@vitest/ui": "^4.0.18",
		"eslint": "^10.0.3",
		"tsx": "^4.21.0",
		"typedoc": "^0.28.17",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	}
}
