{
	"id": "page",
	"kind": "page",
	"label": "Page - UI Component",
	"description": "A page component — a routable top-level view that composes layouts and UI components.",
	"icon": "file-text",
	"images": [],
	"prompts": [
		{ "variable": "description", "label": "Description", "default": "", "required": false },
		{ "variable": "owner", "label": "Owner / team", "default": "", "required": false }
	],
	"files": [
		{ "path": "components/{{kebab}}/{{kebab}}.md", "templateId": "component-doc" },
		{ "path": "components/{{kebab}}/{{kebab}}.test.ts", "templateId": "component-test" },
		{ "path": "components/{{kebab}}/{{kebab}}.json", "templateId": "component-definition" },
		{ "path": "components/{{kebab}}/{{kebab}}.ts", "templateId": "component-component" },
		{ "path": "components/{{kebab}}/{{kebab}}.stories.ts", "templateId": "component-story" }
	],
	"metadata": {
		"type": "page",
		"status": "draft",
		"route": "",
		"interfaces": [],
		"dependencies": []
	},
	"properties": [
		{ "key": "title", "type": "string", "default": "", "description": "Page title" },
		{ "key": "route", "type": "string", "default": "", "description": "Route path for navigation" },
		{ "key": "authenticated", "type": "boolean", "default": false, "description": "Whether the page requires authentication" }
	],
	"actions": [
		{ "name": "onNavigate", "description": "Fired when the page is navigated to" },
		{ "name": "onLeave", "description": "Fired when the user leaves the page" }
	],
	"variants": [
		{ "name": "authenticated", "label": "Authenticated", "props": { "authenticated": true, "title": "Dashboard" } },
		{ "name": "public", "label": "Public", "props": { "authenticated": false, "title": "Home" } }
	],
	"states": [
		{ "name": "loading", "label": "Loading", "description": "Page content is loading", "props": { "title": "Loading..." } },
		{ "name": "error", "label": "Error", "description": "Page failed to load", "props": { "title": "Error" } }
	],
	"nextSteps": [
		"Edit components/{{kebab}}/{{kebab}}.md to describe the page purpose",
		"Compose layouts and UI components in components/{{kebab}}/",
		"Run tests: npm test"
	]
}
