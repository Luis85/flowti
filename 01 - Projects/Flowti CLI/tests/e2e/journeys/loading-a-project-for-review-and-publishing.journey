			"actions": [
				{
					"tool": "command",
					"id": "flowti:open-loading-a-project-for-review-and-publishing"
				},
				{
					"tool": "wait",
					"ms": 500
				},
				{
					"tool": "screenshot"
				}
			]
		},
		{
			"id": "loading-a-project-for-review-and-publishing-02",
