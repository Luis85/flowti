filters:
  and:
    - file.path.containsAll("flowti", "docs", "features", "backlog")
views:
  - type: table
    name: Backlog
    groupBy:
      property: feature
      direction: ASC
    order:
      - file.name
      - type
      - description
      - stage
      - priority
      - feature
    columnSize:
      file.name: 352
      note.description: 726
