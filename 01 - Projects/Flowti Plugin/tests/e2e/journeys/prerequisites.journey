{
	"journey": "Prerequisites",
	"chapter": 1,
	"description": "Validates the test environment is ready: CLI connectivity, vault file operations, frontmatter, search, plugin activation, health check, EventBus, commands, and services. Writes progress line-by-line into E2E Test Run.md for live visibility.",
	"testSource": "tests/e2e/00-prerequisites.test.ts",
	"reportPath": "docs/journeys/Prerequisites/Prerequisites.md",
	"canvasPath": "docs/journeys/Prerequisites/Prerequisites.canvas",
	"tools": [],
	"lifecycle": {
		"enablePlugin": false,
		"checkInstalled": false,
		"startTrace": false,
		"openActivityLog": false
	},
	"gateFlags": ["_e2ePrerequisitesPassed"],
	"anchor": true,
	"setup": [
		{
			"id": "chapter-header",
			"title": "Log chapter start",
			"guideSection": 0,
			"description": "Writes the Chapter 1 header to the E2E Test Run log.",
			"actions": [
				{
					"tool": "write-run-log",
					"message": "\n## Chapter 1: Prerequisites\n",
					"description": "Write chapter header to run log"
				}
			]
		}
	],
	"teardown": [
		{
			"id": "set-installer-done-flag",
			"title": "Set installer-done gate flag if vault already installed",
			"guideSection": 99,
			"description": "In skip mode (vault already installed), sets _e2eInstallerDone so downstream journey tests can proceed without running the installer.",
			"actions": [
				{
					"tool": "eval",
					"code": "(() => { if ('{{installerMode}}' === 'skip' && String(window._e2ePrerequisitesPassed) === 'true') { window._e2eInstallerDone = true; } return 'ok'; })()",
					"description": "Conditionally set _e2eInstallerDone when vault already installed"
				}
			]
		}
	],
	"steps": [
		{
			"id": "01-cli-connectivity",
			"title": "CLI can reach Obsidian",
			"guideSection": 1,
			"description": "Verifies the Obsidian CLI can execute JavaScript in the running Obsidian instance. This is the foundation — every subsequent test depends on CLI connectivity.",
			"expectedInput": "Obsidian running with the test vault open",
			"expectedOutput": "eval('1+1') returns '2'",
			"interactions": ["eval: CLI connectivity check"],
			"actions": [
				{ "tool": "notice", "message": "1/10 — Checking CLI connectivity...", "duration": 3000 },
				{
					"tool": "eval",
					"code": "(() => { var r = 1 + 1; if (r !== 2) throw new Error('Expected 2, got ' + r); return String(r); })()",
					"expect": { "type": "equals", "value": "2" },
					"store": "cliResult",
					"description": "CLI eval returns 2"
				},
				{
					"tool": "write-run-log",
					"message": "- [x] **CLI Connectivity** — eval(1+1) = {{cliResult}}"
				},
				{ "tool": "screenshot", "label": "cli-ok", "description": "CLI connectivity confirmed" }
			]
		},
		{
			"id": "02-file-crud",
			"title": "Vault accepts file operations",
			"guideSection": 2,
			"description": "Creates a test markdown file, reads it back, and verifies the content matches. Confirms the CLI-to-vault file I/O pipeline works.",
			"expectedInput": "CLI accessible, vault responsive",
			"expectedOutput": "Created file content matches on read-back",
			"interactions": ["eval: Create file", "eval: Read file back"],
			"actions": [
				{ "tool": "notice", "message": "2/10 — Checking vault file operations...", "duration": 3000 },
				{
					"tool": "eval",
					"code": "(async () => { var path = '03 - Resources/Test Data/prereq-crud.md'; var existing = app.vault.getAbstractFileByPath(path); if (existing) await app.vault.delete(existing, true); await app.vault.create(path, '# E2E CRUD Test'); await new Promise(function(r) { setTimeout(r, 500); }); var f = app.vault.getAbstractFileByPath(path); if (!f) throw new Error('File not found after create'); var content = await app.vault.read(f); if (!content.includes('E2E CRUD Test')) throw new Error('Content mismatch: ' + content.substring(0, 100)); return 'ok'; })()",
					"description": "Create file, read back, verify content"
				},
				{
					"tool": "write-run-log",
					"message": "- [x] **File CRUD** — Created and verified prereq-crud.md"
				}
			]
		},
		{
			"id": "03-frontmatter",
			"title": "Frontmatter properties persist",
			"guideSection": 3,
			"description": "Creates a file with YAML frontmatter, sets a property via processFrontMatter, reads the file back and verifies the property was written.",
			"expectedInput": "File CRUD works",
			"expectedOutput": "Property 'status: verified' appears in file content",
			"interactions": ["eval: Create file with frontmatter", "eval: Set property", "eval: Read and verify"],
			"actions": [
				{ "tool": "notice", "message": "3/10 — Checking frontmatter persistence...", "duration": 3000 },
				{
					"tool": "eval",
					"code": "(async () => { var path = '03 - Resources/Test Data/prereq-fm.md'; var existing = app.vault.getAbstractFileByPath(path); if (existing) await app.vault.delete(existing, true); await app.vault.create(path, '---\\ntype: test\\n---\\n# Frontmatter Test'); await new Promise(function(r) { setTimeout(r, 1000); }); var f = app.vault.getAbstractFileByPath(path); if (!f) throw new Error('File not found'); await app.fileManager.processFrontMatter(f, function(fm) { fm.status = 'verified'; }); await new Promise(function(r) { setTimeout(r, 1000); }); var content = await app.vault.read(f); if (!content.includes('verified')) throw new Error('Frontmatter property not found after set'); return 'ok'; })()",
					"description": "Create file with frontmatter, set property, verify persistence"
				},
				{
					"tool": "write-run-log",
					"message": "- [x] **Frontmatter** — Property persisted via processFrontMatter"
				}
			]
		},
		{
			"id": "04-search",
			"title": "Vault search indexes content",
			"guideSection": 4,
			"description": "Creates a file with a unique token, then verifies it is indexed by the metadata cache.",
			"expectedInput": "File CRUD works",
			"expectedOutput": "File is indexed in metadata cache",
			"interactions": ["eval: Create file with token", "eval: Verify indexed"],
			"actions": [
				{ "tool": "notice", "message": "4/10 — Checking search indexing...", "duration": 3000 },
				{
					"tool": "eval",
					"code": "(async () => { var token = 'prereq-search-' + Date.now(); var path = '03 - Resources/Test Data/prereq-search.md'; var existing = app.vault.getAbstractFileByPath(path); if (existing) await app.vault.delete(existing, true); await app.vault.create(path, '# Search\\n' + token); await new Promise(function(r) { setTimeout(r, 2000); }); var f = app.vault.getAbstractFileByPath(path); if (!f) throw new Error('Search test file not found after create'); var cache = app.metadataCache.getFileCache(f); var cacheInfo = cache ? Object.keys(cache).join(', ') : 'empty'; return cacheInfo; })()",
					"store": "cacheKeys",
					"description": "Create file, wait for indexing, verify metadata cache"
				},
				{
					"tool": "write-run-log",
					"message": "- [x] **Search Index** — File indexed — cache keys: {{cacheKeys}}"
				}
			]
		},
		{
			"id": "05-installer-state",
			"title": "Prepare installer state",
			"guideSection": 5,
			"description": "In installer mode: disables plugin, resets installer state in data.json, and removes seed files via vault API. In skip mode: verifies seed files exist.",
			"expectedInput": "data.json exists in plugin directory",
			"expectedOutput": "Installer state prepared for the appropriate mode",
			"interactions": ["seed: Verify or remove seed files based on mode"],
			"actions": [
				{
					"tool": "notice",
					"message": "5/10 — Preparing installer state ({{installerMode}} mode)...",
					"duration": 5000
				},
				{
					"tool": "eval",
					"code": "(() => { if ('{{installerMode}}' === 'skip') return 'verify'; return 'delete'; })()",
					"store": "seedMode",
					"description": "Determine seed operation: verify in skip mode, delete in installer mode"
				},
				{
					"tool": "seed",
					"id": "all",
					"mode": "{{seedMode}}",
					"description": "Skip mode: verify seed files exist. Installer mode: remove seed files."
				},
				{
					"tool": "eval",
					"code": "(() => { if ('{{installerMode}}' !== 'installer') return 'skipped'; app.plugins.disablePlugin('{{PLUGIN_ID}}'); return 'disabling'; })()",
					"description": "Disable plugin if installer mode"
				},
				{ "tool": "notice", "message": "Waiting for plugin to unload...", "duration": 5000 },
				{ "tool": "wait", "ms": 5000, "description": "Wait for plugin to disable" },
				{
					"tool": "eval",
					"code": "(() => { if ('{{installerMode}}' !== 'installer') return 'ok'; if (app.plugins.plugins['{{PLUGIN_ID}}']) throw new Error('Plugin still loaded after disable'); return 'ok'; })()",
					"expect": { "type": "equals", "value": "ok" },
					"description": "Verify plugin disabled (installer mode)"
				},
				{
					"tool": "eval",
					"code": "(async () => { if ('{{installerMode}}' !== 'installer') return 'skip'; var dp = '.obsidian/plugins/{{PLUGIN_ID}}/data.json'; var raw = await app.vault.adapter.read(dp); var data = JSON.parse(raw); data.installer = { installed: false, completedSteps: {} }; await app.vault.adapter.write(dp, JSON.stringify(data)); await new Promise(function(r) { setTimeout(r, 1000); }); return 'reset'; })()",
					"store": "installerState",
					"description": "Reset installer state in data.json"
				},
				{
					"tool": "write-run-log",
					"message": "- [x] **Installer State** — {{installerMode}} mode prepared"
				},
				{ "tool": "screenshot", "label": "installer-state", "description": "Installer state prepared" }
			]
		},
		{
			"id": "06-plugin-activated",
			"title": "Flowti plugin activates successfully",
			"guideSection": 6,
			"description": "Enables the Flowti IBDE plugin, starts the EventBus event trace, and opens the Activity Log sidebar. In installer mode the wizard opens automatically; in skip mode the plugin loads normally.",
			"expectedInput": "Installer state prepared",
			"expectedOutput": "Plugin is loaded, trace collecting, Activity Log open",
			"commands": ["app.plugins.enablePlugin"],
			"interactions": ["eval: Enable plugin", "eval: Start trace", "eval: Open Activity Log"],
			"actions": [
				{ "tool": "notice", "message": "6/10 — Activating plugin...", "duration": 5000 },
				{
					"tool": "eval",
					"code": "app.plugins.enablePlugin('{{PLUGIN_ID}}')",
					"description": "Enable the Flowti plugin"
				},
				{ "tool": "wait", "ms": 3000, "description": "Wait for plugin to initialize" },
				{
					"tool": "eval",
					"code": "(() => { if (!app.plugins.plugins['{{PLUGIN_ID}}']) throw new Error('Plugin not loaded after enable'); return 'ok'; })()",
					"expect": { "type": "equals", "value": "ok" },
					"description": "Verify plugin is loaded"
				},
				{ "tool": "notice", "message": "6/10 — Starting EventBus trace...", "duration": 3000 },
				{
					"tool": "eval",
					"code": "(() => { var p = app.plugins.plugins['{{PLUGIN_ID}}']; if (p && p.eventBus && !p._e2eEventTrace) { p._e2eEventTrace = []; p._e2ePerfTrace = []; p._e2eTraceUnsub = p.eventBus.on('*', function(event) { if (event.type.startsWith('log.')) return; if (event.type.startsWith('perf.')) { p._e2ePerfTrace.push({ type: event.type, ts: Date.now(), payload: JSON.stringify(event.payload || {}).substring(0, 500) }); return; } p._e2eEventTrace.push({ type: event.type, ts: Date.now(), payload: JSON.stringify(event.payload || {}).substring(0, 200) }); }); } return 'ok'; })()",
					"description": "Start EventBus event trace collection"
				},
				{ "tool": "notice", "message": "6/10 — Opening Activity Log...", "duration": 3000 },
				{
					"tool": "eval",
					"code": "(async () => { var existing = app.workspace.getLeavesOfType('flowti-event-log')[0]; if (existing) { app.workspace.revealLeaf(existing); } else { var leaf = app.workspace.getRightLeaf(false); if (leaf) leaf.setViewState({ type: 'flowti-event-log', active: true }); } await new Promise(function(r) { setTimeout(r, 1000); }); return 'ok'; })()",
					"description": "Open Activity Log in right sidebar"
				},
				{
					"tool": "write-run-log",
					"message": "- [x] **Plugin Activation** — Plugin loaded, trace started, Activity Log opened"
				},
				{ "tool": "screenshot", "label": "plugin-activated", "description": "Plugin activated with trace running" }
			]
		},
		{
			"id": "07-plugin-health",
			"title": "Plugin reports healthy state",
			"guideSection": 7,
			"description": "Inspects the plugin state: loaded=true, no errors, and counts the number of registered services.",
			"expectedInput": "Plugin enabled",
			"expectedOutput": "loaded=true, services.length > 0",
			"interactions": ["eval: Check plugin health"],
			"actions": [
				{ "tool": "notice", "message": "7/10 — Checking plugin health...", "duration": 3000 },
				{
					"tool": "eval",
					"code": "(() => { var p = app.plugins.plugins['{{PLUGIN_ID}}']; if (!p) throw new Error('Plugin not loaded'); var keys = Object.keys(p).filter(function(k) { return k.endsWith('Service'); }); if (keys.length === 0) throw new Error('No services registered'); return String(keys.length); })()",
					"store": "serviceCount",
					"description": "Verify plugin is healthy with services"
				},
				{
					"tool": "write-run-log",
					"message": "- [x] **Plugin Health** — {{serviceCount}} services registered"
				}
			]
		},
		{
			"id": "08-eventbus",
			"title": "EventBus is collecting events",
			"guideSection": 8,
			"description": "Verifies the plugin's EventBus is available, the E2E event trace array is initialized, and reports how many events have been collected so far.",
			"expectedInput": "Plugin loaded, event trace started",
			"expectedOutput": "eventBus exists and _e2eEventTrace is an array with events",
			"interactions": ["eval: Check EventBus trace"],
			"actions": [
				{ "tool": "notice", "message": "8/10 — Checking EventBus trace...", "duration": 3000 },
				{
					"tool": "eval",
					"code": "(() => { var p = app.plugins.plugins['{{PLUGIN_ID}}']; if (!p || !p.eventBus) throw new Error('EventBus not available'); if (!Array.isArray(p._e2eEventTrace)) throw new Error('Event trace not initialized'); return p._e2eEventTrace.length + '/' + (p._e2ePerfTrace || []).length; })()",
					"store": "traceCounts",
					"description": "Verify EventBus and trace array, report event count"
				},
				{
					"tool": "write-run-log",
					"message": "- [x] **EventBus** — Trace active — {{traceCounts}} events/perf metrics"
				}
			]
		},
		{
			"id": "09-commands",
			"title": "Flowti commands are registered",
			"guideSection": 9,
			"description": "Verifies the Flowti command pipeline is wired up by checking that the Activity Log view is present in the right sidebar.",
			"expectedInput": "Plugin loaded with registered commands, Activity Log opened",
			"expectedOutput": "flowti-event-log leaf exists in the workspace",
			"uiContext": {
				"view": "flowti-event-log",
				"viewName": "Activity Log",
				"components": ["EventLogView"]
			},
			"interactions": ["eval: Check Activity Log leaf"],
			"actions": [
				{ "tool": "notice", "message": "9/10 — Checking command registration...", "duration": 3000 },
				{
					"tool": "eval",
					"code": "(async () => { var count = app.workspace.getLeavesOfType('flowti-event-log').length; if (count === 0) { try { app.commands.executeCommandById('{{PLUGIN_ID}}:flowti:open-event-log'); } catch(e) {} await new Promise(function(r) { setTimeout(r, 1000); }); count = app.workspace.getLeavesOfType('flowti-event-log').length; } if (count === 0) throw new Error('Activity Log leaf not found'); return 'ok'; })()",
					"description": "Verify Activity Log leaf exists, retry via command if needed"
				},
				{
					"tool": "write-run-log",
					"message": "- [x] **Commands** — Activity Log leaf present in sidebar"
				}
			]
		},
		{
			"id": "10-services",
			"title": "Required services are available",
			"guideSection": 10,
			"description": "Reads the plugin's registered service keys, verifies the essential services are present, and writes the final summary to the progress file.",
			"expectedInput": "Plugin loaded and healthy",
			"expectedOutput": "Service keys include userService, analyticsService, dataExchangeService",
			"interactions": ["eval: Check required services"],
			"actions": [
				{ "tool": "notice", "message": "10/10 — Checking required services...", "duration": 3000 },
				{
					"tool": "eval",
					"code": "(() => { var p = app.plugins.plugins['{{PLUGIN_ID}}']; var keys = Object.keys(p).filter(function(k) { return k.endsWith('Service'); }); var required = ['analyticsService', 'dataExchangeService', 'userService']; for (var i = 0; i < required.length; i++) { if (keys.indexOf(required[i]) === -1) throw new Error('Missing required service: ' + required[i]); } return required.join(', ') + ' (' + keys.length + ' total)'; })()",
					"store": "servicesInfo",
					"description": "Verify required services"
				},
				{
					"tool": "write-run-log",
					"message": "- [x] **Services** — {{servicesInfo}}"
				},
				{ "tool": "screenshot", "label": "services", "description": "All required services available" }
			]
		}
	]
}
