# Normalize line endings — LF in repo, native on checkout
* text=auto eol=lf

# Explicitly binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Canvas files: always LF to prevent phantom diffs from Obsidian re-serialization
*.canvas text eol=lf
# base files: always LF to prevent phantom diffs from Obsidian re-serialization
*.base text eol=lf
