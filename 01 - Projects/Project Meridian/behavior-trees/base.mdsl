root {
    selector {

        /* P-1: Honor current commitment (unless critical override) */
        sequence {
            condition [IsCommitted]
            flip { condition [NeedsCritical] }
            action [ContinueCommitment]
        }

        /* P0: Critical survival — most dangerous need first */
        sequence {
            condition [NeedsCritical]
            selector {
                /* Rest if exhausted — energy depletion is most dangerous */
                sequence {
                    condition [IsExhausted]
                    action [ChooseServiceFacility, "rest"]
                    action [SeekService]
                    action [UseService] while(IsExhausted)
                }
                /* Drink if thirsty and have water */
                sequence {
                    condition [IsThirsty]
                    condition [HasWater]
                    action [Drink]
                }
                /* Thirsty: buy water at a well if affordable */
                sequence {
                    condition [IsThirsty]
                    flip { condition [HasWater] }
                    condition [CanAffordItem, "water"]
                    action [SeekWell]
                    action [BuyItem, "water"]
                    action [Drink]
                }
                /* Thirsty: buy water at the market if affordable */
                sequence {
                    condition [IsThirsty]
                    flip { condition [HasWater] }
                    condition [CanAffordItem, "water"]
                    action [SeekMarket]
                    action [BuyItem, "water"]
                    action [Drink]
                }
                /* Eat if hungry and have food */
                sequence {
                    condition [IsHungry]
                    condition [HasFood]
                    action [Eat] while(IsHungry)
                }
                /* Buy food if hungry and available at current location */
                sequence {
                    condition [IsHungry]
                    condition [CanAffordFood]
                    condition [FacilityHasStock, "food"]
                    action [Buy]
                }
                /* Seek known food source */
                sequence {
                    condition [IsHungry]
                    condition [CanAffordFood]
                    condition [KnowsFoodSource]
                    action [SeekBestFoodSource]
                    action [Buy]
                }
                /* Fallback: seek any food source if desperate */
                sequence {
                    condition [IsHungry]
                    condition [CanAffordFood]
                    action [SeekFood]
                    action [Buy]
                }
            }
        }

        /* P0.5: Social emergency — extreme isolation */
        sequence {
            condition [IsSociallyCritical]
            selector {
                sequence {
                    condition [NearAgentClose]
                    action [Talk]
                }
                action [SeekSocial]
            }
        }

        /* P1: Claim a job if unemployed and facility available */
        sequence {
            condition [IsWorkHours]
            condition [HasNoJob]
            condition [OpenProductionFacilityNearby]
            action [ClaimBestJob]
        }

        /* P1.5: Desperate job search — move toward distant job facilities */
        sequence {
            condition [IsWorkHours]
            condition [HasNoJob]
            action [SeekJobFacility]
        }

        /* P1.9: Sell excess goods when overloaded — takes priority over work */
        sequence {
            condition [IsOverloaded]
            flip { condition [IsNighttime] }
            flip { condition [IsRecovering] }
            selector {
                sequence {
                    condition [AtLocation, "market_stall"]
                    action [SellAtMarket]
                }
                action [SeekMarket]
            }
        }

        /* P1.95: Continue active quest AT CURRENT facility — preempts work.
         * Without this, a repair quest at 100% progress can sit forever because
         * P2 SeekWork fires the moment the repair commit expires. This branch
         * only applies when the agent is already at the quest facility, so it
         * never causes travel interruptions — agents finish what they're doing
         * before walking off to work. */
        sequence {
            condition [HasQuest]
            condition [QuestAtFacility]
            selector {
                sequence {
                    condition [QuestCargoReady]
                    action [CompleteQuest]
                }
                action [WorkRepair]
            }
        }

        /* P2: Role-specific behavior (work hours: dawn + day, skip if recovering) */
        sequence {
            condition [IsWorkHours]
            flip { condition [IsRecovering] }
            branch [Job]
        }

        /* P2.5: Leisure — rest day or stressed */
        sequence {
            selector {
                condition [IsRestDay]
                condition [IsMoodLow]
            }
            flip { condition [IsNighttime] }
            action [ChooseServiceFacility, "leisure"]
            action [SeekService]
            action [UseService] while(IsUsingService)
        }

        /* P3: Thirsty — drink, or buy water at a well/market */
        sequence {
            condition [IsThirsty]
            selector {
                sequence {
                    condition [HasWater]
                    action [Drink]
                }
                sequence {
                    condition [CanAffordItem, "water"]
                    action [SeekWell]
                    action [BuyItem, "water"]
                    action [Drink]
                }
                sequence {
                    condition [CanAffordItem, "water"]
                    action [SeekMarket]
                    action [BuyItem, "water"]
                    action [Drink]
                }
            }
        }

        /* P4: Hungry — eat or buy */
        sequence {
            condition [IsHungry]
            selector {
                sequence {
                    condition [HasFood]
                    action [Eat] while(IsHungry)
                }
                sequence {
                    condition [CanAffordFood]
                    condition [FacilityHasStock, "food"]
                    action [Buy]
                }
                sequence {
                    condition [CanAffordFood]
                    selector {
                        sequence {
                            condition [KnowsFoodSource]
                            action [SeekBestFoodSource]
                        }
                        action [SeekFood]
                    }
                    action [Buy]
                }
                sequence {
                    condition [HasJob]
                    condition [IsWorkHours]
                    action [SeekWork]
                }
            }
        }

        /* P4.25: Complete active quest (repair, supply, restock) */
        sequence {
            condition [HasQuest]
            selector {
                /* At quest facility with cargo ready — complete it */
                sequence {
                    condition [QuestAtFacility]
                    condition [QuestCargoReady]
                    action [CompleteQuest]
                }
                /* At quest facility — work repair */
                sequence {
                    condition [QuestAtFacility]
                    action [WorkRepair]
                }
                /* Cargo not ready — go source the item from a production facility */
                sequence {
                    flip { condition [QuestCargoReady] }
                    action [SeekQuestSource]
                    action [PickupForQuest]
                }
                /* Travel to quest facility (has cargo, just needs to deliver) */
                action [SeekQuestFacility]
            }
        }

        /* P4.3: Claim available quest if idle */
        sequence {
            flip { condition [HasQuest] }
            condition [QuestAvailable]
            action [ClaimQuest]
        }

        /* P4.6: Supply chain — haul goods between facilities */
        sequence {
            condition [IsWorkHours]
            flip { condition [IsRecovering] }
            selector {
                /* Deliver cargo if carrying */
                sequence {
                    condition [HasCargo]
                    selector {
                        sequence {
                            condition [CargoDestinationNearby]
                            action [DeliverCargo]
                        }
                        action [SeekDeliveryTarget]
                    }
                }
                /* Pick up cargo if at supply source */
                sequence {
                    condition [FacilityNeedsSupply]
                    action [PickupCargo]
                }
                /* Find a supply route from known locations */
                sequence {
                    condition [KnowsSupplyRoute]
                    action [SeekSupplySource]
                }
            }
        }

        /* P5: Energy — rest when tired */
        sequence {
            condition [IsExhausted]
            action [ChooseServiceFacility, "rest"]
            action [SeekService]
            action [UseService] while(IsExhausted)
        }

        /* P5.5: Switch to better-paying job if available */
        sequence {
            condition [IsWorkHours]
            condition [HasJob]
            condition [BetterPayAvailable]
            action [SwitchJob]
        }

        /* P5.7: Socialize when lonely */
        sequence {
            condition [IsLonely]
            selector {
                sequence {
                    condition [NearAgentClose]
                    action [Talk]
                }
                action [SeekSocial]
            }
        }

        /* P6: Personal sleep time */
        sequence {
            condition [ShouldSleep]
            action [ChooseServiceFacility, "rest"]
            action [SeekService]
            action [UseService] while(ShouldSleep)
        }

        /* P7: Fallback */
        action [Wander]
    }
}
