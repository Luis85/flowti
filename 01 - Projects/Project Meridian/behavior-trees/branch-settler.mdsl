root [Role] {
    selector {
        /* Harvest food from farm if stock available */
        sequence {
            condition [AtJobFacility]
            condition [FacilityHasStock, "food"]
            action [Harvest]
        }

        /* Sell food at market if carrying any */
        sequence {
            condition [AtLocation, "market"]
            condition [HasFood]
            action [SellAtMarket]
        }
        /* Go to market to sell if carrying food */
        sequence {
            condition [HasFood]
            action [SeekMarket]
        }

        /* Work at facility */
        sequence {
            condition [AtJobFacility]
            action [Work] while(IsWorkHours)
        }

        /* Go to work */
        sequence {
            condition [HasJob]
            action [SeekWork]
        }

        action [Wander]
    }
}
