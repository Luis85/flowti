{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "../dist",
    "rootDir": "../src",
    "baseUrl": "../src",
    "types": ["obsidian"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["../src/**/*.ts"],
  "exclude": ["../tests/**/*.ts", "../node_modules"]
}
