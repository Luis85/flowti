root [Job] {
    selector {
        /* Collect produced tools from workshop */
        sequence {
            condition [AtJobFacility]
            condition [FacilityHasStock, "tools"]
            action [CollectProduced]
        }
        /* Work at workshop */
        sequence {
            condition [AtJobFacility]
            action [Work] while(IsWorkHours)
        }
        /* Go to work */
        sequence {
            condition [HasJob]
            action [SeekWork]
        }

        action [Wander]
    }
}
