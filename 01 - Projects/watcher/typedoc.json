{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src"],
  "entryPointStrategy": "expand",
  "tsconfig": "tsconfig.typedoc.json",
  "out": "docs/codebase",

  "exclude": [
    "**/node_modules/**",
    "**/tests/**",
    "**/dist/**",
    "**/docs/**"
  ],

  "name": "Foreign Folder Watcher",
  "readme": "README.md",

  "categorizeByGroup": true,
  "categoryOrder": ["Core", "Services", "Watchers", "Modals", "Settings", "Types", "Utilities", "*"],
  "groupOrder": ["Classes", "Interfaces", "Functions", "Type Aliases", "Variables", "*"],

 

  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": true,

  "visibilityFilters": {
    "protected": true,
    "private": false,
    "inherited": true,
    "@internal": false
  },

  "searchInComments": true,
  "searchInDocuments": true
}
