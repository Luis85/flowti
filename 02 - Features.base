filters:
  and:
    - file.folder.containsAny("features")
    - file.ext == "md"
views:
  - type: table
    name: Features
    groupBy:
      property: domain
      direction: ASC
    order:
      - file.name
      - stage
      - domain
      - plugin
      - file.folder
      - type
    columnSize:
      file.name: 265
      note.stage: 117
      note.domain: 119
      note.plugin: 104
  - type: table
    name: Flowti
    filters:
      and:
        - file.folder.contains("flowti")
        - type == "ProductRequirementsDocument"
    order:
      - file.name
      - stage
      - priority
      - maturity
      - description
    sort:
      - property: priority
        direction: DESC
      - property: maturity
        direction: DESC
    columnSize:
      file.name: 265
      note.stage: 106
      note.domain: 119
  - type: table
    name: Folder Watcher
    filters:
      and:
        - file.folder.contains("watcher")
    groupBy:
      property: domain
      direction: ASC
    order:
      - file.name
      - stage
      - domain
      - file.folder
    columnSize:
      file.name: 265
      note.stage: 72
      note.domain: 119
