filters:
  and:
    - file.folder.containsAny("features")
    - file.ext == "md"
    - '!file.folder.contains("backlog")'
views:
  - type: table
    name: Product Features
    filters:
      and:
        - file.tags.contains("core")
    groupBy:
      property: domain
      direction: ASC
    order:
      - file.name
      - stage
      - domain
      - plugin
      - file.folder
      - type
    columnSize:
      file.name: 276
      note.stage: 117
      note.domain: 119
      note.plugin: 104
  - type: table
    name: Features
    groupBy:
      property: domain
      direction: ASC
    order:
      - file.name
      - stage
      - domain
      - plugin
      - file.folder
      - type
    columnSize:
      file.name: 276
      note.stage: 117
      note.domain: 119
      note.plugin: 104
  - type: table
    name: Flowti
    filters:
      and:
        - file.folder.contains("flowti")
        - type == "ProductRequirementsDocument"
    order:
      - file.name
      - stage
      - priority
      - maturity
      - description
      - fri_score
      - implementation_cost
      - maintenance_cost
      - maturity_score_architecture
      - maturity_score_data_model
      - maturity_score_event_integration
      - maturity_score_scope
      - maturity_score_strategy
      - maturity_score_ui_consistency
      - maturity_score_validation_testing
      - test_cost
      - discovery_cost
      - design_cost
      - business_value
    sort:
      - property: fri_score
        direction: DESC
      - property: priority
        direction: DESC
      - property: maturity
        direction: DESC
    columnSize:
      file.name: 265
      note.stage: 106
      note.domain: 119
  - type: table
    name: Folder Watcher
    filters:
      and:
        - file.folder.contains("watcher")
    groupBy:
      property: domain
      direction: ASC
    order:
      - file.name
      - stage
      - domain
      - file.folder
    columnSize:
      file.name: 265
      note.stage: 72
      note.domain: 119
