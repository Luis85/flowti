filters:
  and:
    - file.inFolder("Development/flowti/docs/cycles")
    - type == "DevelopmentCycle"
formulas:
  bugs_count: bugs.length
views:
  - type: table
    name: Planned
    filters:
      and:
        - "!cycle.isEmpty()"
    order:
      - file.name
      - stage
      - formula.bugs_count
      - feature
      - tags
    sort:
      - property: cycle
        direction: DESC
    columnSize:
      file.name: 376
      note.stage: 104
  - type: table
    name: Open
    filters:
      and:
        - cycle.isEmpty()
    order:
      - file.name
      - stage
      - formula.bugs_count
      - feature
    sort:
      - property: cycle
        direction: DESC
    columnSize:
      file.name: 376
      note.stage: 104
  - type: table
    name: Index
    order:
      - cycle
      - file.name
      - stage
      - formula.bugs_count
      - feature
    sort:
      - property: cycle
        direction: DESC
    columnSize:
      file.name: 376
      note.stage: 104
