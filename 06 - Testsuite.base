filters:
  and:
    - file.folder.contains("journey")
    - file.ext == "md"
views:
  - type: table
    name: Index
    order:
      - file.mtime
      - file.name
      - success
      - status
      - duration
      - total_steps
      - passed
      - failed
      - total_actions
      - test_source
      - tags
    columnSize:
      file.mtime: 160
      file.name: 261
      note.total_steps: 106
      note.passed: 101
      note.failed: 82
      note.total_actions: 112
