{
	"name": "Flowti Plugin",
	"type": "obsidian-plugin",
	"build": {
		"commands": {
			"fast": "node esbuild.config.mjs --production --no-reports",
			"full": "npm run build",
			"watch": "node esbuild.config.mjs --watch",
			"distribute": "node esbuild.config.mjs --production --no-reports --distribution"
		}
	},
	"test": {
		"commands": {
			"unit": "npx vitest run",
			"flows": "npx vitest run tests/flows/",
			"e2e": "npm run test:e2e"
		}
	},
	"devtools": {
		"commands": {
			"lint": "npx eslint src/",
			"check": "npx tsc --noEmit --skipLibCheck",
			"reload": "node scripts/cli-reload.mjs"
		},
		"thresholds": {
			"maxComplexity": 15,
			"maxLines": 400
		}
	},
	"reports": {
		"dir": "docs/reports",
		"allCommand": "npm run generate:reports",
		"generators": [
			{ "label": "Test Report", "command": "node scripts/generate-test-report.mjs" },
			{ "label": "Coverage Report", "command": "node scripts/generate-coverage-report.mjs" },
			{ "label": "Build Report", "command": "node scripts/generate-build-report.mjs" },
			{ "label": "Codebase Report", "command": "node scripts/generate-codebase-report.mjs" },
			{ "label": "Cycle Report", "command": "node scripts/generate-cycle-report.mjs" },
			{ "label": "Trace Report", "command": "node scripts/generate-trace-report.mjs" },
			{ "label": "Performance Report", "command": "node scripts/generate-performance-report.mjs" },
			{ "label": "Complexity Report", "command": "node scripts/generate-complexity-report.mjs" },
			{ "label": "E2E Report", "command": "node scripts/generate-e2e-report.mjs" }
		],
		"thresholds": {
			"coverageLines": 80,
			"coverageBranches": 70,
			"maxComplexity": 15,
			"complexityAboveThresholdPct": 5,
			"startupMs": 5000,
			"eslintWarnings": 0
		}
	},
	"review": {
		"commands": {
			"build": "npm run build:increment",
			"test": "npm run test:e2e",
			"teardown": "node scripts/run-e2e.mjs --teardown",
			"rebuild": "node scripts/run-e2e.mjs --rebuild"
		}
	},
	"docs": {
		"generators": [
			{ "label": "Command Reference", "command": "node scripts/generate-command-reference.mjs" },
			{ "label": "Event Catalog", "command": "node scripts/generate-event-catalog.mjs" },
			{ "label": "Data Dictionary", "command": "node scripts/generate-data-dictionary.mjs" },
			{ "label": "Tool Reference", "command": "node scripts/generate-tool-reference.mjs" },
			{ "label": "CLI Reference", "command": "node scripts/generate-cli-reference.mjs" }
		]
	},
	"make": {
		"templates": ["hub", "plugin", "app"]
	},
	"health": {
		"thresholds": {
			"coverage": { "min": 75, "target": 85 },
			"lint": { "maxErrors": 0, "maxWarnings": 10 },
			"tests": { "minPassed": 7000 }
		}
	}
}
