filters:
  and:
    - file.inFolder("Development/flowti/docs/jobs to be done")
views:
  - type: table
    name: Index
    groupBy:
      property: persona
      direction: ASC
    order:
      - file.name
      - persona
      - domain
      - domains
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 555
