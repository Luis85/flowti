filters:
  and:
    - file.inFolder("Development/flowti/docs/sitemap")
properties:
  note.Source:
    displayName: source
views:
  - type: table
    name: Views
    groupBy:
      property: feature
      direction: ASC
    order:
      - file.name
      - description
      - parent
      - feature
      - Source
      - tags
    columnSize:
      file.name: 203
      note.description: 450
      note.parent: 132
      note.feature: 191
