filters:
  and:
    - file.inFolder("Development/flowti/docs/decisions")
views:
  - type: table
    name: Decision Log
    order:
      - file.name
      - status
      - date
      - domain
      - category
    sort: []
    columnWidths:
      adr: 80
      title: 300
      status: 100
      date: 100
      domain: 140
      category: 140
    columnSize:
      file.name: 410
