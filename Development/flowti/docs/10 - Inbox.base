filters:
  and:
    - file.inFolder("Development/flowti/docs/inbox")
views:
  - type: table
    name: Table
    order:
      - type
      - file.name
      - stage
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      note.type: 71
      file.name: 704
      note.stage: 112
