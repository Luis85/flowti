filters:
  and:
    - file.inFolder("Development/flowti/docs/cycles")
    - type == "DevelopmentCycle"
views:
  - type: table
    name: Table
    order:
      - file.name
      - stage
      - estimated_increments
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 374
