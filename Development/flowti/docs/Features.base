filters:
  and:
    - file.inFolder("Development/flowti/docs/features")
    - file.ext == "md"
views:
  - type: table
    name: Features
    order:
      - file.name
      - stage
      - domain
      - plugin
      - tags
    columnSize:
      file.name: 169
      note.stage: 126
      note.domain: 132
