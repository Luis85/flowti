filters:
  and:
    - file.inFolder("Development/flowti/docs/features")
    - file.ext == "md"
views:
  - type: table
    name: Features
    order:
      - file.name
      - stage
      - domain
      - plugin
      - tags
    columnSize:
      file.name: 199
      note.stage: 126
      note.domain: 132
  - type: table
    name: Product Features
    filters:
      and:
        - file.hasTag("core")
    order:
      - file.name
      - description
      - stage
      - domain
      - tags
    columnSize:
      file.name: 199
      note.description: 395
      note.stage: 126
      note.domain: 132
