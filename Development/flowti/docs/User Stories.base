filters:
  and:
    - file.inFolder("Development/flowti/docs/user-stories")
views:
  - type: table
    name: User Stories
    groupBy:
      property: feature
      direction: ASC
    order:
      - file.name
      - title
      - stage
      - description
      - domain
      - journey
      - jtbd
      - parent
      - persona
      - feature
    columnSize:
      file.name: 516
      note.stage: 101
      note.parent: 140
