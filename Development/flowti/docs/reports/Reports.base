filters:
  and:
    - file.inFolder("Development/flowti/docs/reports/e2e")
    - file.ext == "md"
    - type == "E2EReport"
views:
  - type: table
    name: End to End Tests
    filters:
      and:
        - '!file.folder.contains("run")'
    order:
      - file.name
      - type
    sort:
      - property: file.ctime
        direction: DESC
  - type: table
    name: Index
    order:
      - file.name
      - type
    sort:
      - property: file.ctime
        direction: DESC
  - type: table
    name: Performance Report
    filters:
      and:
        - file.inFolder("Development/flowti/docs/reports/performance")
    order:
      - date
      - file.name
      - data_json_size_bytes
      - startup_max
      - startup_measurements
      - startup_p50
      - startup_p95
      - startup_total_ms
    sort:
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 367
  - type: table
    name: Codebase Report
    filters:
      and:
        - file.inFolder("Development/flowti/docs/reports/codebase")
    order:
      - file.name
      - classes
      - constructors
      - functions
      - interfaces
      - methods
      - modules
      - type_aliases
    sort:
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 437
  - type: table
    name: Build Reports
    filters:
      and:
        - file.inFolder("Development/flowti/docs/reports/builds")
    order:
      - file.name
      - duration_ms
      - total_bytes
      - errors_count
    sort:
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 437
  - type: table
    name: Coverage Report
    filters:
      and:
        - file.inFolder("Development/flowti/docs/reports/coverage")
    order:
      - date
      - file.name
      - files_covered
      - branches_pct
      - lines_pct
      - functions_pct
      - statements_pct
    sort:
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 305
