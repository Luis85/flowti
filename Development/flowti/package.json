{
  "name": "flowti-ibde",
  "version": "0.0.1",
  "description": "The Flowti IBDE. A simple Obsidian plugin.",
  "main": "main.js",
  "scripts": {
    "test": "npm run check && vitest run",
    "test:watch": "npm run check && vitest",
    "test:ui": "npm run check && vitest --ui",
    "test:coverage": "npm run check && vitest run --coverage",
    "test:flows": "vitest run tests/flows/ --coverage",
    "test:e2e": "vitest run tests/flows/ && node scripts/run-e2e.mjs",
    "test:e2e:installer": "vitest run tests/flows/ && node scripts/run-e2e.mjs --journey=installer",
    "test:e2e:getting-started": "vitest run tests/flows/ && node scripts/run-e2e.mjs --journey=getting-started",
    "test:e2e:components": "vitest run tests/flows/ && node scripts/run-e2e.mjs --journey=component-library",
    "test:e2e:canvas-session": "vitest run tests/flows/ && node scripts/run-e2e.mjs --journey=canvas-session",
    "test:e2e:journeys": "vitest run tests/flows/ && node scripts/run-e2e.mjs --journey=getting-started,component-library,canvas-session",
    "test:e2e:quick": "vitest run tests/flows/ && node scripts/run-e2e.mjs --journey=installer,getting-started",
    "report:e2e": "node scripts/generate-e2e-report.mjs",
    "build": "npm run test:flows && node esbuild.config.mjs --production",
    "build:dev": "node esbuild.config.mjs --watch",
    "dev:reload": "node scripts/cli-reload.mjs",
    "dev:console": "obsidian dev:console",
    "dev:errors": "obsidian dev:errors",
    "build:release": "npm run test:coverage && npm run docs && node esbuild.config.mjs --publish",
    "build:distribution": "npm run test:coverage && npm run docs && node esbuild.config.mjs --distribution",
    "build:increment": "npm run test:e2e && npm run build:distribution",
    "check": "npm run lint && tsc -noEmit -skipLibCheck",
    "lint": "eslint ./src/",
    "docs": "typedoc",
    "generate:testdata": "node scripts/generate-test-data.mjs",
    "generate:reports": "node scripts/generate-test-report.mjs && node scripts/generate-coverage-report.mjs && node scripts/generate-codebase-report.mjs && node scripts/generate-cycle-report.mjs && node scripts/generate-trace-report.mjs && node scripts/generate-command-reference.mjs && node scripts/generate-event-catalog.mjs && node scripts/generate-data-dictionary.mjs && node scripts/generate-performance-report.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "business-development",
    "process-management",
    "quality-management"
  ],
  "author": "Luis Mendez",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/papaparse": "^5.5.2",
    "@typescript-eslint/eslint-plugin": "8.53.0",
    "@typescript-eslint/parser": "8.53.0",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "builtin-modules": "5.0.0",
    "esbuild": "0.27.2",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "happy-dom": "^20.6.1",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "typedoc": "^0.28.16",
    "typescript": "5.9.3",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "papaparse": "^5.5.3",
    "zod": "^4.3.5"
  }
}
