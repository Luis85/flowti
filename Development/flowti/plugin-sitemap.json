				{ "id": "compliance", "label": "Compliance", "icon": "shield", "handler": "test-mgmt:compliance", "searchPlaceholder": "Search standards..." },
				{ "id": "feature-quality", "label": "Feature Quality", "icon": "star", "handler": "test-mgmt:feature-quality", "searchPlaceholder": "Search features..." },
				{ "id": "features", "label": "Features", "icon": "sparkles", "handler": "test-mgmt:features", "searchPlaceholder": "Search features..." },
