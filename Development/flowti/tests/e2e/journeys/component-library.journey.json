{
	"journey": "Component Library",
	"chapter": 4,
	"description": "Systematically opens each of the 5 hubs, navigates to every tab (including the dashboard), and captures a screenshot — a visual regression baseline for all hub views.",
	"testSource": "tests/e2e/40-journey-component-library.test.ts",
	"reportPath": "docs/journeys/Component Library/Component Library.md",
	"canvasPath": "docs/journeys/Component Library/Component Library.canvas",
	"tools": ["command", "highlight", "navigate", "assert", "wait", "screenshot", "close-leaves"],
	"steps": [
		{
			"id": "01-event-catalog-open",
			"title": "Open Event Catalog",
			"guideSection": 1,
			"description": "Opens the Event Catalog hub via command.",
			"expectedOutput": "flowti-event-catalog leaf is active",
			"uiContext": { "view": "flowti-event-catalog", "viewName": "Event Catalog" },
			"commands": ["flowti:open-event-catalog"],
			"actions": [
				{ "tool": "close-leaves", "viewType": "flowti-event-catalog", "description": "Close stale Event Catalog leaves" },
				{ "tool": "command", "id": "flowti:open-event-catalog", "description": "Open Event Catalog" },
				{ "tool": "wait", "ms": 1000 },
				{ "tool": "assert", "type": "leaf", "viewType": "flowti-event-catalog", "description": "Event Catalog leaf is open" },
				{ "tool": "screenshot", "label": "open", "description": "Event Catalog opened" }
			]
		},
		{
			"id": "02-event-catalog-dashboard",
			"title": "Event Catalog Dashboard",
			"guideSection": 2,
			"description": "Screenshots the Event Catalog dashboard (default view).",
			"uiContext": { "view": "flowti-event-catalog", "viewName": "Event Catalog", "components": ["WorkspaceShell", "Dashboard"] },
			"actions": [
				{ "tool": "highlight", "selector": ".ft-dashboard", "description": "Highlight dashboard area" },
				{ "tool": "wait", "ms": 500 },
				{ "tool": "screenshot", "label": "dashboard", "description": "Event Catalog dashboard" }
