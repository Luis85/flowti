filters:
  and:
    - file.inFolder("00 - Connectivity/events")
    - type == "Event"
formulas:
  foo: description
views:
  - type: table
    name: Eventstream
    order:
      - type
      - file.name
      - description
      - formula.foo
    columnSize:
      file.name: 178
      note.name: 117
      note.type: 86
