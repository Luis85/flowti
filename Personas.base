filters:
  and:
    - file.folder.contains("personas")
views:
  - type: table
    name: Personas
    groupBy:
      property: domain
      direction: ASC
    order:
      - file.name
      - plugin
      - domain
      - file.folder
      - type
    columnSize:
      file.name: 168
      note.plugin: 109
      note.domain: 123
      file.folder: 268
