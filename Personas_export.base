filters:
  and:
    - file.inFolder("00 - Connectivity/imports/imported")
    - file.ext == "md"
views:
  - type: table
    name: Imported Data
    order:
      - file.name
      - name
      - folder
      - ctime
      - mtime
      - path
      - tags
      - links
      - backlinks
      - basename
      - embeds
      - fullname
      - ext
      - plugin
      - domain
