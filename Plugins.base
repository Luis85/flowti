filters:
  and:
    - file.name.contains("README")
    - '!file.folder.contains("node_modules")'
    - file.folder.contains("Development")
views:
  - type: table
    name: Plugins
    order:
      - file.name
      - title
      - description
      - stage
      - author
      - license
      - platform
      - file.folder
      - tags
      - git_repo_url
    columnSize:
      note.title: 258
      file.folder: 193
