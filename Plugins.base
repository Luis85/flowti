filters:
  and:
    - file.name.contains("README")
    - '!file.folder.contains("node_modules")'
    - file.folder.contains("Development")
views:
  - type: table
    name: Plugins
    order:
      - file.name
      - title
      - stage
      - file.folder
    columnSize:
      note.title: 258
      file.folder: 193
