filters:
  and:
    - file.folder.contains("user-stories")
views:
  - type: table
    name: User Stories
    groupBy:
      property: parent
      direction: ASC
    order:
      - domain
      - file.name
      - title
      - jtbd
      - journey
      - parent
      - file.folder
    columnSize:
      note.domain: 183
      file.name: 422
      note.parent: 146
      file.folder: 267
  - type: table
    name: User Stories by Domain
    groupBy:
      property: domain
      direction: ASC
    order:
      - file.name
      - parent
      - title
      - jtbd
      - journey
      - domain
      - file.folder
    columnSize:
      file.name: 341
      note.parent: 146
      note.domain: 139
      file.folder: 267
